# Chấm Writing bằng API OpenAI-compatible (chỉ dùng phía server).
# Không đặt các biến này sau NEXT_PUBLIC_.
#
# Ví dụ Groq:
#   WRITING_AI_BASE_URL=https://api.groq.com/openai/v1
#   WRITING_AI_MODEL=openai/gpt-oss-120b
#   WRITING_AI_FALLBACK_MODEL=qwen/qwen3.8-27b
#
# Ví dụ Gemini (endpoint OpenAI-compatible):
#   WRITING_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   WRITING_AI_MODEL=gemini-3.8-flash
#   WRITING_AI_FALLBACK_MODEL=gemini-3.5-flash-lite

WRITING_AI_BASE_URL=
WRITING_AI_API_KEY=
WRITING_AI_MODEL=
WRITING_AI_FALLBACK_MODEL=

# Tùy chọn
# WRITING_AI_LABEL=Groq
# json_schema (mặc định, khuyến nghị) hoặc json_object
# WRITING_AI_JSON_MODE=json_schema
# WRITING_AI_MAX_TOKENS=3000
# WRITING_AI_REASONING_EFFORT=low

# Tương thích cấu hình cũ: nếu không có WRITING_AI_*, app tự dùng Gemini/Groq.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
